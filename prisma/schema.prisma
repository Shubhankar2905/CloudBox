generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String?
  name         String
  storageLimit BigInt   @default(10737418240) // 10 GiB
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  files              File[]
  folders            Folder[]
  createdSharedLinks SharedLink[] @relation("SharedLinkCreator")
}

model File {
  id String @id @default(cuid())

  name     String
  size     BigInt
  mimeType String

  storageKey String @unique

  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  folder      Folder?      @relation(fields: [folderId], references: [id])
  folderId    String?
  sharedLinks SharedLink[]

  @@index([userId])
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User     @relation(fields: [ownerId], references: [id])
  parent   Folder?  @relation("FolderChildren", fields: [parentId], references: [id])
  children Folder[] @relation("FolderChildren")
  files    File[]
}

model SharedLink {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  fileId        String
  createdById   String
  allowDownload Boolean   @default(true)
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  createdBy User @relation("SharedLinkCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([createdById])
}
